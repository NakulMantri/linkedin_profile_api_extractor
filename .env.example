# You can supply either the complete browser Cookie header (highly recommended to bypass anti-bot locks):
COOKIE_HEADER="bcookie=...; li_at=your_li_at_here; JSESSIONID=\"ajax:your_jsessionid_here\"; ..."

# Or fallback to individual keys (prone to quick session invalidation):
LI_AT=your_li_at_cookie_here
JSESSIONID="ajax:your_jsessionid_here"

# Server Configuration
HOST=0.0.0.0
PORT=8000
